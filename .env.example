# ==============================================================================
# Angaza Rentals System — Production Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
#
# QUICK SETUP FOR LIVE EMAIL (e.g. Gmail):
# 1. Go to your Google Account -> Security -> 2-Step Verification (turn ON).
# 2. Go to 'App passwords' (search 'App passwords' in Google Account search bar).
# 3. Create a new App Password named 'Angaza Rentals'.
# 4. Google gives you a 16-character code (e.g. 'abcd efgh ijkl mnop').
# 5. Paste it in MAIL_PASSWORD below (no spaces).
# ==============================================================================

# Flask Core & Security
SECRET_KEY=angaza-rental-production-super-secret-key-change-this-2026
FLASK_CONFIG=production
FLASK_APP=run.py

# Public Production URL (Used for generating real links in activation & reset emails)
# Example: https://app.angazarentals.com or http://your-server-ip:5000
APP_BASE_URL=https://app.angazarentals.com

# Database URL (Defaults to SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/angaza_rentals

# ==============================================================================
# OPTION 1: LIVE EMAIL VIA GMAIL (Fastest & Free)
# ==============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=dancanmbaabu1@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_DEFAULT_SENDER="Angaza Rentals" <dancanmbaabu1@gmail.com>

# ==============================================================================
# OPTION 2: LIVE EMAIL VIA TRANSACTIONAL PROVIDER (Brevo / Sendinblue or SendGrid)
# ==============================================================================
# MAIL_SERVER=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your_brevo_login@email.com
# MAIL_PASSWORD=your_brevo_smtp_key
# MAIL_DEFAULT_SENDER="Angaza Property System" <notifications@yourdomain.com>

# ==============================================================================
# OPTION 3: LIVE EMAIL VIA CUSTOM DOMAIN / CPANEL WEBMAIL
# ==============================================================================
# MAIL_SERVER=mail.angazarentals.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=noreply@angazarentals.com
# MAIL_PASSWORD=your_webmail_password
# MAIL_DEFAULT_SENDER="Angaza Property System" <noreply@angazarentals.com>

# ==============================================================================
# Safaricom Daraja M-Pesa Integration (Production or Sandbox)
# ==============================================================================
MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=your_daraja_consumer_key
# MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# MPESA_PASSKEY=your_daraja_passkey
# MPESA_SHORTCODE=your_paybill_or_till_number
